# Copy to backend/.env for local runs. Never commit real keys.
# --- core
DATABASE_URL=sqlite:////absolute/path/to/backend/kaksha_dev.db    # or postgresql+psycopg://user:pass@host/db
JWT_SECRET=change-me-in-production
CORS_ORIGINS=*
UPLOAD_DIR=./uploads

# --- Claude (required for AI features; without it the app runs the deterministic fallbacks)
ANTHROPIC_API_KEY=
MODEL_EXTRACT=claude-haiku-4-5-20251001
MODEL_PLAN=claude-sonnet-5
MODEL_TUTOR=claude-sonnet-5

# --- Speech (optional; without it voice features ask for a typed transcript)
SARVAM_API_KEY=

# --- Limits / policy
DAILY_BUDGET_INR_PER_SCHOOL=250
PHOTO_TTL_DAYS=7
AUDIO_TTL_HOURS=24
# Auto-accept AI proposals ONLY when high-confidence + arithmetic-verified (numeracy). Off by default.
AUTO_ACCEPT_HIGH_CONFIDENCE=false
